{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "autoupdate": true,
  "username": "Aloosh",
  "instructions": ["AGENTS.md"],
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },
}
