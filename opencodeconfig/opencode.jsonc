{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "autoupdate": true,
  "username": "Aloosh",
  "instructions": ["AGENTS.md"],
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
  },
  "command": {
    "init-agents": {
      "description": "Generate an AGENTS.md file corresponding to the project",
      "agent": "build",
      "model": "openai/gpt-5.4",
      "template": "Follow the command instructions in @commands/init-agents.md. Treat the markdown frontmatter as metadata and use the body as the task instructions.",
    },
    "update-agents": {
      "description": "Update AGENTS.md from the current project state",
      "agent": "build",
      "model": "openai/gpt-5.4",
      "template": "Follow the command instructions in @commands/update-agents.md. Treat the markdown frontmatter as metadata and use the body as the task instructions.",
    },
  },
  "agent": {
    // This agent will be used to plan out a feature -> ask questions to gather context, discuss with the user, suggest alternative approaches if the currect approach sucks, etc.
    "plan": {
      "description": "Primary planning agent. Use for discussing requirements, asking clarifying questions, evaluating tradeoffs, and producing implementation plans without making changes.",
      "mode": "primary",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:prompts/plan.md}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false,
      },
    },

    "neovim": {
      "description": "Neovim-focused agent for small, efficient changes and concise explanations. Prioritize minimal, low-risk diffs.",
      "mode": "primary",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:prompts/neovim.md}",
      "tools": {
        "read": true,
        "bash": true,
        "write": true,
        "edit": true,
      },
    },

    "context-gatherer": {
      "description": "Read-only codebase exploration agent. Use for finding relevant files, tracing flows, identifying dependencies, and summarizing existing behavior.",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:prompts/context_gatherer.md}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false,
      },
    },

    // This agent will be used to plan how to implement an agreed upon feature
    "implementation-planner": {
      "description": "Implementation planning agent. Use after requirements are agreed to produce concrete step-by-step plans, file targets, risks, and sequencing.",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:prompts/implementation_planner.md}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false,
      },
    },

    "refactor-reviewer": {
      "description": "Refactor and design review agent. Use to critique structure, identify smells, suggest safer refactors, and compare alternative designs.",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "prompt": "{file:prompts/refactor_reviewer.md}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false,
      },
    },
  },
}
