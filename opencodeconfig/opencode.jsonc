{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "autoupdate": false,
  "share": "disabled",
  "username": "Aloosh",
  "instructions": ["AGENTS.md"],
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama",
      },
      "models": {
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7b",
          "family": "qwen35",
          "reasoning": true,
          "tool_call": true,
        },
        },
      },
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },
  "permission": {
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
  },
}
