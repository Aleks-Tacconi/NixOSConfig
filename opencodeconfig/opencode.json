{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "/etc/profiles/per-user/aleks/bin/brave",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "90000",
        "--snapshot-mode",
        "incremental"
      ],
      "enabled": true
    },
    "wp_mcp": {
      "type": "remote",
      "url": "http://localhost/wp-json/mcp/mcp-adapter-default-server",
      "oauth": false,
      "enabled": true,
      "headers": {
        "Authorization": "{file:~/.config/opencode/wp-mcp-authorization}"
      }
    },
    "gluestack": {
      "type": "local",
      "command": ["node", "/home/aleks/.config/opencode/mcp-servers/gluestack-mcp/index.js"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref={env:SUPABASE_PROJECT_REF}",
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "mcp-react-native-expo": {
      "type": "local",
      "command": ["npx", "@divagnz/mcp-react-native-expo@0.0.1"]
    }
  }
}
