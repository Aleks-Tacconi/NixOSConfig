{
  "mcpServers": {
    "ai-nvim": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/aleks/ai-nvim",
        "run",
        "python",
        "/home/aleks/ai-nvim/mcp_server.py"
      ]
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "http://localhost:3000",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "<your service account token>"
      }
    }
  }
}
