diff --git a/src/dbus/dbusmenu/appmenuregistrar.hpp b/src/dbus/dbusmenu/appmenuregistrar.hpp
new file mode 100644
index 0000000..4b60d78
--- /dev/null
+++ b/src/dbus/dbusmenu/appmenuregistrar.hpp
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <qdbuscontext.h>
+#include <qdbusextratypes.h>
+#include <qdbusservicewatcher.h>
+#include <qhash.h>
+#include <qobject.h>
+#include <qqmlintegration.h>
+#include <qtmetamacros.h>
+#include <qtypes.h>
+
+#include "dbusmenu.hpp"
+
+namespace qs::dbus::dbusmenu {
+
+/// Provides native application menus registered through Canonical's global menu protocol.
+class AppMenuRegistrar
+    : public QObject
+    , protected QDBusContext {
+	Q_OBJECT;
+	Q_PROPERTY(quint64 revision READ revision NOTIFY revisionChanged);
+	QML_ELEMENT;
+	QML_SINGLETON;
+
+public:
+	explicit AppMenuRegistrar(QObject* parent = nullptr);
+
+	[[nodiscard]] quint64 revision() const { return this->mRevision; }
+
+	/// Returns the sole menu endpoint registered by pid, or null when no exact match is safe.
+	Q_INVOKABLE qs::menu::QsMenuHandle* menuForPid(quint32 pid) const;
+	/// Adds a verified menu endpoint exported without compositor appmenu support.
+	Q_INVOKABLE void registerMenuForPid(
+	    quint32 pid, const QString& service, const QString& path
+	);
+
+	// Canonical com.canonical.AppMenu.Registrar adaptor methods.
+	// NOLINTBEGIN
+	void RegisterWindow(quint32 windowId, const QDBusObjectPath& menuObjectPath);
+	void UnregisterWindow(quint32 windowId);
+	QString GetMenuForWindow(
+	    quint32 windowId,
+	    QDBusObjectPath& menuObjectPath
+	) const;
+	// NOLINTEND
+
+signals:
+	void revisionChanged();
+
+private slots:
+	void onServiceUnregistered(const QString& service);
+
+private:
+	struct Registration {
+		quint32 pid = 0;
+		QString service;
+		QString path;
+		DBusMenuHandle* handle = nullptr;
+	};
+
+	void tryRegisterService();
+	void removeSender(const QString& service);
+	void markChanged();
+
+	QDBusServiceWatcher serviceWatcher;
+	QHash<QString, QHash<quint32, Registration>> registrations;
+	quint64 mRevision = 0;
+	bool registered = false;
+};
+
+} // namespace qs::dbus::dbusmenu
diff --git a/src/dbus/dbusmenu/appmenuregistrar.cpp b/src/dbus/dbusmenu/appmenuregistrar.cpp
new file mode 100644
index 0000000..2232e80
--- /dev/null
+++ b/src/dbus/dbusmenu/appmenuregistrar.cpp
@@ -0,0 +1,204 @@
+#include "appmenuregistrar.hpp"
+
+#include <appmenu_registrar.h>
+#include <qdbusconnection.h>
+#include <qdbusconnectioninterface.h>
+#include <qdbusmessage.h>
+#include <qdbusreply.h>
+#include <qlogging.h>
+#include <qstring.h>
+
+namespace qs::dbus::dbusmenu {
+
+namespace {
+constexpr auto SERVICE = "com.canonical.AppMenu.Registrar";
+constexpr auto PATH = "/com/canonical/AppMenu/Registrar";
+} // namespace
+
+AppMenuRegistrar::AppMenuRegistrar(QObject* parent): QObject(parent) {
+	new AppMenuRegistrarAdaptor(this);
+
+	auto bus = QDBusConnection::sessionBus();
+	if (!bus.isConnected()) {
+		qWarning() << "Could not connect to DBus. AppMenu registrar will not work.";
+		return;
+	}
+
+	if (!bus.registerObject(PATH, this)) {
+		qWarning() << "Could not register the AppMenu registrar DBus object.";
+		return;
+	}
+
+	QObject::connect(
+	    &this->serviceWatcher,
+	    &QDBusServiceWatcher::serviceUnregistered,
+	    this,
+	    &AppMenuRegistrar::onServiceUnregistered
+	);
+	this->serviceWatcher.setConnection(bus);
+	this->serviceWatcher.setWatchMode(QDBusServiceWatcher::WatchForUnregistration);
+	this->serviceWatcher.addWatchedService(SERVICE);
+
+	this->tryRegisterService();
+}
+
+void AppMenuRegistrar::tryRegisterService() {
+	if (this->registered) return;
+
+	this->registered = QDBusConnection::sessionBus().registerService(SERVICE);
+	if (!this->registered) {
+		qWarning() << "Another AppMenu registrar owns" << SERVICE
+		           << "; native application menus are unavailable to this Quickshell instance.";
+	}
+}
+
+void AppMenuRegistrar::RegisterWindow(
+    quint32 windowId,
+    const QDBusObjectPath& menuObjectPath
+) {
+	const auto service = this->message().service();
+	if (service.isEmpty() || menuObjectPath.path().isEmpty()) return;
+
+	const auto pidReply = QDBusConnection::sessionBus().interface()->servicePid(service);
+	if (!pidReply.isValid() || pidReply.value() == 0) {
+		qWarning().noquote() << "Ignoring AppMenu registration without a resolvable pid from"
+		                     << service;
+		return;
+	}
+
+	auto& senderRegistrations = this->registrations[service];
+	auto existing = senderRegistrations.find(windowId);
+	if (existing != senderRegistrations.end()
+	    && existing->path == menuObjectPath.path()
+	    && existing->pid == pidReply.value())
+		return;
+
+	if (existing != senderRegistrations.end()) existing->handle->deleteLater();
+
+	auto* handle = new DBusMenuHandle(this);
+	handle->setAddress(service, menuObjectPath.path());
+	senderRegistrations.insert(
+	    windowId,
+	    Registration {pidReply.value(), service, menuObjectPath.path(), handle}
+	);
+	this->serviceWatcher.addWatchedService(service);
+	this->markChanged();
+}
+
+void AppMenuRegistrar::UnregisterWindow(quint32 windowId) {
+	const auto service = this->message().service();
+	auto sender = this->registrations.find(service);
+	if (sender == this->registrations.end()) return;
+
+	auto registration = sender->find(windowId);
+	if (registration == sender->end()) return;
+
+	registration->handle->deleteLater();
+	sender->erase(registration);
+	if (sender->isEmpty()) {
+		this->registrations.erase(sender);
+		this->serviceWatcher.removeWatchedService(service);
+	}
+
+	this->markChanged();
+}
+
+QString AppMenuRegistrar::GetMenuForWindow(
+    quint32 windowId,
+    QDBusObjectPath& menuObjectPath
+) const {
+	QString service;
+	service.clear();
+	menuObjectPath = QDBusObjectPath("/");
+
+	for (const auto& sender: this->registrations) {
+		const auto registration = sender.constFind(windowId);
+		if (registration == sender.cend()) continue;
+		if (!service.isEmpty()
+		    && (service != registration->service || menuObjectPath.path() != registration->path)) {
+			service.clear();
+			menuObjectPath = QDBusObjectPath("/");
+			return service;
+		}
+
+		service = registration->service;
+		menuObjectPath = QDBusObjectPath(registration->path);
+	}
+
+	return service;
+}
+
+qs::menu::QsMenuHandle* AppMenuRegistrar::menuForPid(quint32 pid) const {
+	if (pid == 0) return nullptr;
+
+	const Registration* match = nullptr;
+	for (const auto& sender: this->registrations) {
+		for (const auto& registration: sender) {
+			if (registration.pid != pid) continue;
+			if (match != nullptr
+			    && (match->service != registration.service || match->path != registration.path))
+				return nullptr;
+
+			match = &registration;
+		}
+	}
+
+	return match == nullptr ? nullptr : match->handle;
+}
+
+void AppMenuRegistrar::registerMenuForPid(
+    quint32 pid,
+    const QString& service,
+    const QString& path
+) {
+	if (pid == 0 || service.isEmpty() || !path.startsWith('/')) return;
+
+	const auto pidReply = QDBusConnection::sessionBus().interface()->servicePid(service);
+	if (!pidReply.isValid() || pidReply.value() != pid) {
+		qWarning().noquote() << "Ignoring discovered AppMenu endpoint with mismatched pid from"
+		                     << service;
+		return;
+	}
+
+	auto& senderRegistrations = this->registrations[service];
+	auto existing = senderRegistrations.find(0);
+	if (existing != senderRegistrations.end()
+	    && existing->path == path
+	    && existing->pid == pid)
+		return;
+
+	if (existing != senderRegistrations.end()) existing->handle->deleteLater();
+
+	auto* handle = new DBusMenuHandle(this);
+	handle->setAddress(service, path);
+	senderRegistrations.insert(0, Registration {pid, service, path, handle});
+	this->serviceWatcher.addWatchedService(service);
+	this->markChanged();
+}
+
+void AppMenuRegistrar::onServiceUnregistered(const QString& service) {
+	if (service == SERVICE) {
+		this->registered = false;
+		this->tryRegisterService();
+		return;
+	}
+
+	this->removeSender(service);
+}
+
+void AppMenuRegistrar::removeSender(const QString& service) {
+	auto sender = this->registrations.find(service);
+	if (sender == this->registrations.end()) return;
+
+	for (const auto& registration: *sender) registration.handle->deleteLater();
+	this->registrations.erase(sender);
+	this->serviceWatcher.removeWatchedService(service);
+	this->markChanged();
+}
+
+void AppMenuRegistrar::markChanged() {
+	++this->mRevision;
+	emit this->revisionChanged();
+}
+
+} // namespace qs::dbus::dbusmenu
