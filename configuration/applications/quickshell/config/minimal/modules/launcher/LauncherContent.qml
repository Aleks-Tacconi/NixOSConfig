ry"], ["🇿🇼", "flag zimbabwe flags country"], ["🏴󠁧󠁢󠁥󠁮󠁧󠁿", "flag england flags subdivision"], ["🏴󠁧󠁢󠁳󠁣󠁴󠁿", "flag scotland flags subdivision"], ["🏴󠁧󠁢󠁷󠁬󠁳󠁿", "flag wales flags subdivision"],].map(emoji => ({
